# Copy this file to .env and fill in your values.
# Never commit .env — it's listed in .gitignore.

# ---- LLM ----------------------------------------------------------------
# Set to true to skip the real LLM and return sample water-cycle quiz data.
# Useful when you don't have an API key or want fast local testing.
MOCK_LLM=false

# Groq API key — FREE tier at https://console.groq.com (recommended for testing)
# If both are set, Groq is used. If neither is set, use MOCK_LLM=true.
GROQ_API_KEY=

# OpenAI API key — paid, used if GROQ_API_KEY is not set
OPENAI_API_KEY=sk-...

# ---- Database -----------------------------------------------------------
# Defaults to SQLite in the backend directory (fine for local dev).
# For Postgres: postgresql://user:password@localhost:5432/quizdb
DATABASE_URL=sqlite:///./quizzes.db
